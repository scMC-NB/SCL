<Window x:Class="SCL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SCL" Width="1120" Height="720" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#F5F7FA" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI" Loaded="Window_Loaded" Icon="/Images/icon.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ========== 现代光感配色 ========== -->
        <SolidColorBrush x:Key="ThemePrimary"      Color="#3B6EF5"/>
        <SolidColorBrush x:Key="ThemePrimaryHover" Color="#2A5BE8"/>
        <SolidColorBrush x:Key="ThemePrimarySoft"  Color="#EAF0FE"/>
        <SolidColorBrush x:Key="BgBrush"           Color="#F5F7FA"/>
        <SolidColorBrush x:Key="CardBrush"         Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LineBrush"         Color="#E8EBF0"/>
        <SolidColorBrush x:Key="TextMain"          Color="#1A1D24"/>
        <SolidColorBrush x:Key="TextSub"           Color="#717784"/>
        <SolidColorBrush x:Key="HoverBg"           Color="#F2F4F8"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Direction="270" Color="#0F000000"/>
        <DropShadowEffect x:Key="GlowPrimary" BlurRadius="20" ShadowDepth="0" Color="#3B6EF5" Opacity="0.6"/>

        <!-- ========== 滚动条 ========== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="T" Background="#C9CED6" CornerRadius="3" Margin="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="T" Property="Background" Value="#9CA3AF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 顶部导航按钮 (带发光下划线) ========== -->
        <Style x:Key="TopNavStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="18,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- 发光下划线 -->
                            <Border x:Name="Indicator" Height="3" VerticalAlignment="Bottom" Margin="16,0" CornerRadius="1.5" Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#3B6EF5" Offset="0"/>
                                        <GradientStop Color="#6B8FF8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#3B6EF5" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="IndicatorScale" ScaleX="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="IndicatorScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="IndicatorScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="{StaticResource ThemePrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 窗口按钮 ========== -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource HoverBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaxButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Content" Value="&#xE922;"/>
            <Setter Property="Command" Value="{x:Static SystemCommands.MaximizeWindowCommand}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;"/>
                    <Setter Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ========== 侧边栏菜单 ========== -->
        <Style x:Key="SideMenuStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="16,12">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Indicator" Width="4" Height="20" HorizontalAlignment="Left" Margin="-2,0,0,0" CornerRadius="2" Opacity="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#6B8FF8" Offset="0"/>
                                        <GradientStop Color="#3B6EF5" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#3B6EF5" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="IndicatorScale" ScaleY="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="IndicatorScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="IndicatorScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ThemePrimarySoft}"/>
                                <Setter Property="Foreground" Value="{StaticResource ThemePrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 主按钮 ========== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="B" CornerRadius="8" Padding="{TemplateBinding Padding}" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4F8AF5" Offset="0"/>
                                        <GradientStop Color="#3B6EF5" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border x:Name="Shine" Width="60" HorizontalAlignment="Left" Opacity="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="Transparent" Offset="0"/>
                                                <GradientStop Color="#80FFFFFF" Offset="0.5"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="ShineTranslate" X="-100"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Effect" Value="{StaticResource GlowPrimary}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="ShineTranslate" Storyboard.TargetProperty="X" From="-100" To="400" Duration="0:0:0.5" EasingFunction="{x:Null}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootGrid" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 次按钮 ========== -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource ThemePrimary}"/>
                                <Setter Property="Foreground" Value="{StaticResource ThemePrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 加载器卡片 ========== -->
        <Style x:Key="LoaderCardStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource ThemePrimary}"/>
                                <Setter TargetName="Card" Property="Effect" Value="{StaticResource GlowPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource ThemePrimary}"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource ThemePrimarySoft}"/>
                                <Setter TargetName="Card" Property="Padding" Value="15,19"/>
                                <Setter Property="Foreground" Value="{StaticResource ThemePrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 卡片背景 ========== -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- ========== 列表项 ========== -->
        <Style x:Key="ListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBg" Background="Transparent" CornerRadius="8" Padding="14,12" Margin="4,2" BorderThickness="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBg" Property="Background" Value="{StaticResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBg" Property="Background" Value="{StaticResource ThemePrimarySoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 输入框 ========== -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ThemePrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource ThemePrimary}"/>
                                <Setter TargetName="B" Property="Effect" Value="{StaticResource GlowPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="#C9CED6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 细进度条 ========== -->
        <Style x:Key="ThinProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#F2F4F8"/>
            <Setter Property="Foreground" Value="{StaticResource ThemePrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                                <Border x:Name="Glow" Width="80" HorizontalAlignment="Left" Opacity="0.8" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="GlowTranslate" X="-100"/>
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="GlowTranslate" Storyboard.TargetProperty="X" From="-100" To="1200" Duration="0:0:2.5" EasingFunction="{x:Null}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 环境光晕 -->
        <Grid.Background>
            <RadialGradientBrush Center="0.8,0.1" GradientOrigin="0.8,0.1" RadiusX="1.2" RadiusY="1.2">
                <GradientStop Color="#EAF0FE" Offset="0"/>
                <GradientStop Color="#F5F7FA" Offset="0.8"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Image x:Name="WallpaperImage" Stretch="UniformToFill" Opacity="1" IsHitTestVisible="False"/>
        <Border Background="#E6FFFFFF" IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= 顶部栏 ================= -->
            <Grid Grid.Row="0" Background="#FFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Border Width="28" Height="28" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4F8AF5" Offset="0"/>
                                    <GradientStop Color="#3B6EF5" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="S" Foreground="White" FontWeight="Black" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="SCL" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="Black"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 导航 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <RadioButton x:Name="NavLaunch" Tag="Launch" GroupName="Nav" Style="{StaticResource TopNavStyle}" Checked="NavButton_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="启动" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDownload" Tag="Download" GroupName="Nav" IsChecked="True" Style="{StaticResource TopNavStyle}" Checked="NavButton_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="下载" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavMultiplayer" Tag="Multiplayer" GroupName="Nav" Style="{StaticResource TopNavStyle}" Checked="NavButton_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="联机" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Tag="Settings" GroupName="Nav" Style="{StaticResource TopNavStyle}" Checked="NavButton_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="设置" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- 窗口控制 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" Click="Minimize_Click" ToolTip="最小化"/>
                        <Button Style="{StaticResource MaxButtonStyle}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="最大化"/>
                        <Button Style="{StaticResource CloseButtonStyle}" Content="&#xE8BB;" Click="Close_Click" ToolTip="关闭"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ================= 页面容器 ================= -->
            <Grid Grid.Row="1">
                <!-- ========== 下载页 ========== -->
                <Grid x:Name="PageDownload" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,1,0" Padding="12,24">
                        <StackPanel>
                            <TextBlock Text="下载中心" Foreground="{StaticResource TextSub}" FontSize="11.5"
                                       FontWeight="Bold" Margin="14,0,0,12"/>
                            <RadioButton x:Name="RbRelease" GroupName="VersionCategory" IsChecked="True"
                                         Style="{StaticResource SideMenuStyle}" Checked="VersionCategoryChanged">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="正式版" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbSnapshot" GroupName="VersionCategory"
                                         Style="{StaticResource SideMenuStyle}" Checked="VersionCategoryChanged">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="快照版" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbAprilFools" GroupName="VersionCategory"
                                         Style="{StaticResource SideMenuStyle}" Checked="VersionCategoryChanged">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="愚人节版" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1" Margin="28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="DownloadHeader" Margin="0,0,0,18">
                            <TextBlock x:Name="TxtVersionCount" Text="SCL · 游戏版本" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtOfficialCount" Text="正在获取版本..." Foreground="{StaticResource TextSub}" FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="DownloadVersionBrowser" Grid.Row="1" Style="{StaticResource CardBorder}" Padding="10,12">
                            <ListBox x:Name="ListOfficialVersions" Background="Transparent" BorderThickness="0"
                                     SelectionChanged="OfficialVersions_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItemStyle}"/>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource HoverBg}" Padding="6">
                                                <Image Source="{Binding IconImage}" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="15"/>
                                                <TextBlock Text="SCL 游戏版本" Foreground="{StaticResource TextSub}" FontSize="12" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Tag="{Binding VersionId}" Click="OpenDownloadDetails_Click"
                                                    Style="{StaticResource SecondaryButton}" Padding="14,8" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="查看详情" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <ComboBox x:Name="CmbDownloadVersion" Visibility="Collapsed"/>
                        <Border x:Name="DownloadQuickBar" Visibility="Collapsed"/>
                        <ComboBox x:Name="CmbLoaderType" Visibility="Collapsed"/>
                        <Button x:Name="BtnDownloadVanilla" Visibility="Collapsed"/>

                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="20" Margin="0,16,0,0">
                            <StackPanel>
                                <ProgressBar x:Name="DownloadProgress" Style="{StaticResource ThinProgressBar}" Minimum="0" Maximum="100"/>
                                <TextBlock x:Name="TxtDownloadStatus" Text="就绪" Foreground="{StaticResource TextSub}" FontSize="13" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 安装详情 -->
                        <Grid x:Name="DownloadDetailsPage" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="{StaticResource BgBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Button Click="BackToVersionList_Click" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Left" Margin="0,0,0,20">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="返回版本列表" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="安装游戏" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>

                                    <Border Style="{StaticResource CardBorder}" Margin="0,20,0,20">
                                        <StackPanel>
                                            <TextBlock Text="当前选择版本" Foreground="{StaticResource TextSub}" FontSize="12.5"/>
                                            <TextBlock x:Name="TxtDetailVersion" Text="SCL 1.20.1" FontSize="26" FontWeight="Black"
                                                       Foreground="{StaticResource ThemePrimary}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="选择安装类型" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,12"/>
                                    <UniformGrid Columns="3" Margin="0,0,0,24">
                                        <RadioButton x:Name="DetailLoaderVanilla" GroupName="DetailLoaderCards" Tag="Vanilla" IsChecked="True"
                                                     Style="{StaticResource LoaderCardStyle}" Checked="DetailLoader_Checked" Margin="0,0,16,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="纯净版" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextMain}"/>
                                                <TextBlock Text="没有模组的原版体验" FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="DetailLoaderForge" GroupName="DetailLoaderCards" Tag="Forge"
                                                     Style="{StaticResource LoaderCardStyle}" Checked="DetailLoader_Checked" Margin="0,0,16,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Forge" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextMain}"/>
                                                <TextBlock Text="老牌模组加载器" FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="DetailLoaderFabric" GroupName="DetailLoaderCards" Tag="Fabric"
                                                     Style="{StaticResource LoaderCardStyle}" Checked="DetailLoader_Checked">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Fabric" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextMain}"/>
                                                <TextBlock Text="轻量级模组加载器" FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>

                                    <Button x:Name="BtnInstallFromDetails" Content="开始下载" Click="BtnInstallSelected_Click"
                                            Style="{StaticResource PrimaryButton}" Height="48" HorizontalAlignment="Left" MinWidth="220" FontSize="15"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ========== 启动页 (PCL 风格 + 微软登录) ========== -->
                <Grid x:Name="PageLaunch" Opacity="0" Visibility="Collapsed">
                    <Grid Margin="28,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="380"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：版本列表 -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="10,16" Margin="0,0,16,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="已安装的游戏版本" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="12,0,0,12"/>

                                <ListBox Grid.Row="1" x:Name="ListLatestVersions" Background="Transparent" BorderThickness="0" SelectionChanged="ListLatestVersions_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItemStyle}"/>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource HoverBg}" Padding="4">
                                                    <Image Source="{Binding IconImage}" Stretch="Uniform"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="SCL 游戏版本" Foreground="{StaticResource TextSub}" FontSize="12" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <!-- 保留启动设置按钮，用于进入详情页 -->
                                                <Button Grid.Column="2" Tag="{Binding VersionId}" Click="VersionSelect_Click" Style="{StaticResource SecondaryButton}" Padding="14,8" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="启动设置" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- 右侧：PCL 风格启动面板 -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="28">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 选中的版本展示 -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="100" Height="100" CornerRadius="16" Background="{StaticResource HoverBg}" Padding="12" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
                                        <Image Source="{Binding SelectedItem.IconImage, ElementName=ListLatestVersions}" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedItem.Name, ElementName=ListLatestVersions, TargetNullValue=请选择版本, FallbackValue=请选择版本}" 
                                               FontSize="26" FontWeight="Black" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                                    <TextBlock Text="SCL 游戏实例" FontSize="13" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- 底部：正版登录 & 输入 & 启动 -->
                                <StackPanel Grid.Row="1">

                                    <!-- 🌟 新增：微软正版登录模块 -->
                                    <Border Background="{StaticResource HoverBg}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{StaticResource ThemePrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtLoginStatus" Text="当前未登录" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                                <TextBlock x:Name="TxtLoginSub" Text="支持正版验证，皮肤显示" FontSize="11" Foreground="{StaticResource TextSub}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="BtnMsLogin" Content="微软登录" Click="BtnMsLogin_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Grid.Column="2" Padding="12,6"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="玩家名称" FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtPlayerNameQuick" Text="SCL_Player" Style="{StaticResource InputBox}" Margin="0,0,0,20"/>

                                    <!-- 大号启动按钮 -->
                                    <Button x:Name="BtnQuickLaunch" Click="BtnQuickLaunch_Click" Style="{StaticResource PrimaryButton}" Height="64">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="启动游戏" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <ComboBox x:Name="CmbLaunchVersion" Visibility="Collapsed"/>
                </Grid>

                <!-- ========== 启动详情页 ========== -->
                <Grid x:Name="PageLaunchDetails" Opacity="0" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="28,24">
                        <StackPanel>
                            <Button Click="BackToLaunchList_Click" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="返回" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="26"
                                               Foreground="{StaticResource ThemePrimary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtLaunchVersionTitle" Text="尚未选择版本" FontSize="22" FontWeight="Black"
                                               Foreground="{StaticResource ThemePrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                                   Foreground="{StaticResource TextSub}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="玩家名称" FontSize="13.5"/>
                                    </StackPanel>
                                    <TextBox x:Name="TxtPlayerName" Grid.Column="1" Grid.ColumnSpan="2" Text="SCL_Player" Style="{StaticResource InputBox}"/>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,18,0,0">
                                        <TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                                   Foreground="{StaticResource TextSub}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Java 路径" FontSize="13.5"/>
                                    </StackPanel>
                                    <TextBox x:Name="TxtJavaPath" Grid.Row="1" Grid.Column="1" Style="{StaticResource InputBox}" Margin="0,18,16,0"/>

                                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                            Click="BtnBrowseJava_Click" Margin="0,18,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="浏览" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Button x:Name="BtnStartGame" Click="BtnStartGame_Click" Style="{StaticResource PrimaryButton}"
                                    Width="240" Height="52" HorizontalAlignment="Left" Margin="0,0,0,18">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="启动 SCL" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtLaunchStatus" Text="等待启动游戏…" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <ProgressBar x:Name="LaunchProgress" Minimum="0" Maximum="100" Value="0"
                                                 Style="{StaticResource ThinProgressBar}" Margin="0,14,0,10"/>
                                    <TextBlock x:Name="TxtLaunchDetail" Text="启动进度和状态会显示在这里" FontSize="12.5" Foreground="{StaticResource TextSub}"/>
                                </StackPanel>
                            </Border>
                            <TextBox x:Name="TxtLog" Visibility="Collapsed" IsReadOnly="True"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ========== 联机页 ========== -->
                <Grid x:Name="PageMultiplayer" Opacity="0" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="28,24">
                        <StackPanel>
                            <TextBlock Text="陶瓦联机" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,18"/>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="玩家信息" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <TextBox x:Name="TxtMultiplayerPlayerName" Text="SCL_Player" Style="{StaticResource InputBox}" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="创建房间" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <Button x:Name="BtnMultiplayerCreate" Content="创建联机房间" Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Left" MinWidth="180" Click="BtnMultiplayerCreate_Click" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="加入房间" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <TextBox x:Name="TxtMultiplayerRoomCode" Style="{StaticResource InputBox}" MaxLength="256" Margin="0,14,0,14"/>
                                    <WrapPanel>
                                        <Button x:Name="BtnMultiplayerJoin" Content="加入" Style="{StaticResource PrimaryButton}"
                                                Click="BtnMultiplayerJoin_Click" Margin="0,0,14,0"/>
                                        <Button x:Name="BtnMultiplayerCopyCode" Style="{StaticResource SecondaryButton}"
                                                Click="BtnMultiplayerCopyCode_Click" Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="复制房间码" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnMultiplayerStop" Content="结束联机" Style="{StaticResource SecondaryButton}"
                                                IsEnabled="False" Click="BtnMultiplayerStop_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="联机状态" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock x:Name="TxtMultiplayerStatus" Text="就绪" Foreground="{StaticResource TextSub}" Margin="0,10,0,10" FontSize="13"/>
                                    <ProgressBar x:Name="TerracottaDownloadProgress" Minimum="0" Maximum="100" Value="0"
                                                 Visibility="Collapsed" Style="{StaticResource ThinProgressBar}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="当前房间玩家" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <ListBox x:Name="ListMultiplayerPlayers" MinHeight="100" MaxHeight="240"
                                             Background="Transparent" BorderThickness="0" Margin="0,10,0,0" FontSize="13.5"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ========== 设置页 ========== -->
                <Grid x:Name="PageSettings" Opacity="0" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="28,24">
                        <StackPanel>
                            <TextBlock Text="设置中心" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,18"/>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="外观与壁纸" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Click="ChooseWallpaper_Click" Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="选择壁纸…" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Content="恢复默认" Style="{StaticResource SecondaryButton}" Click="ResetWallpaper_Click" Margin="0,0,14,0"/>
                                        <CheckBox x:Name="ChkDarkModeSettings" Content="深色遮罩" IsChecked="True"
                                                  VerticalAlignment="Center" Checked="ThemeChanged" Unchecked="ThemeChanged" FontSize="13.5"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="SCL 游戏根目录" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <TextBox x:Name="TxtSettingsRoot" Style="{StaticResource InputBox}" IsReadOnly="True" Margin="0,14,0,0"/>
                                    <TextBlock x:Name="TxtGamePath" Foreground="{StaticResource TextSub}" FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>